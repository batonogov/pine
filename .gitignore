# Xcode
xcuserdata/
*.xcscmblueprint
*.xccheckout

# Build
build/
DerivedData/

# Swift Package Manager
.build/
.swiftpm/

# macOS
.DS_Store

# Debug symbols
*.dSYM.zip
*.dSYM/

# Profiling
*.profraw

# Pine editor context (written at runtime)
.pine-context.json

# Screenshots: the canonical screenshot-*.png files in assets/ are
# committed to the repo and refreshed manually via
# scripts/update-screenshots.sh. They are NOT gitignored.
#
# Only ignore the unnamed fallback artifacts produced by the raw
# filesystem extraction strategy in scripts/update-screenshots.sh; those
# are diagnostic-only and must never be committed.
assets/screenshot-unknown-*.png

# Snapshot test failure artifacts
PineTests/SnapshotTests/__Snapshots__/*.actual.png

# Sanitized process-level test diagnostics uploaded by CI
LifecycleDiagnostics/

# Shared agent guidance; local settings, caches, and worktrees stay ignored.
.agents/*
!.agents/rules/
!.agents/skills/
# Claude-specific runtime state is local, not shared instructions.
.claude/
.pi/
.pi-subagents/
.pine/

# Python bytecode from the .github/scripts test suites
__pycache__/
*.pyc
