    "a11y.sidebar.folder.hint": {
      "comment": "VoiceOver hint for a sidebar folder row explaining arrow-key behaviour.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordner. Zum Ein- oder Ausklappen Links- oder Rechts-Taste drücken."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder. Press Left or Right arrow to collapse or expand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carpeta. Pulsa Izquierda o Derecha para colapsar o expandir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dossier. Appuyez sur Flèche gauche ou droite pour replier ou déplier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダ。展開または折りたたむには左矢印または右矢印を押してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더입니다. 접거나 펼치려면 왼쪽 또는 오른쪽 화살표를 누르십시오."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasta. Pressione Esquerda ou Direita para recolher ou expandir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Папка. Нажмите стрелку влево или вправо, чтобы свернуть или развернуть."
