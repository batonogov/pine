    "about.tagline": {
      "comment": "Tagline shown in the About window credits.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Code-Editor, der auf Ihren Mac gehört."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A code editor that belongs on your Mac."
