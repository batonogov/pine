    "agentHistory.emptyMessage": {
      "comment": "Agent History: empty-state explanation (#1073).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgeschlossene Agenten-Sitzungen erscheinen hier. Setze die Änderungen eines Durchlaufs mit einem Klick zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finished agent sessions will appear here. Revert any run's changes with one click."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las sesiones de agente finalizadas aparecerán aquí. Revierte los cambios de cualquier ejecución con un clic."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sessions d'agent terminées apparaîtront ici. Annulez les modifications de n'importe quelle exécution d'un clic."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了したエージェントセッションがここに表示されます。実行の変更をワンクリックで取り消せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료된 에이전트 세션이 여기에 표시됩니다. 클릭 한 번으로 실행 변경 사항을 되돌릴 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessões de agente finalizadas aparecerão aqui. Reverta as alterações de qualquer execução com um clique."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершённые сессии агента появятся здесь. Изменения любого запуска можно отменить одним нажатием."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已完成的智能体会话将显示在此处。一键即可撤销任意运行的更改。"
          }
        }
      }
    },
