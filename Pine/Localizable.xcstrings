    "recovery.message": {
      "comment": "Message shown in recovery dialog after a crash.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pine hat ungesicherte Änderungen aus einer vorherigen Sitzung gefunden. Möchten Sie diese wiederherstellen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pine found unsaved changes from a previous session. Would you like to recover them?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pine encontró cambios sin guardar de una sesión anterior. ¿Desea recuperarlos?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pine a trouvé des modifications non enregistrées d'une session précédente. Voulez-vous les récupérer ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pineは前回のセッションから未保存の変更を検出しました。復元しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pine이 이전 세션에서 저장되지 않은 변경 사항을 발견했습니다. 복구하시겠습니까?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pine encontrou alterações não salvas de uma sessão anterior. Deseja recuperá-las?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Pine обнаружил несохранённые изменения из предыдущей сессии. Хотите их восстановить?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pine 发现了上一个会话中未保存的更改。是否要恢复它们？"
          }
        }
      }
    },
