    "agentHistory.revertPartialFailure": {
      "comment": "Agent History: banner shown when some files failed to revert (#1073).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Dateien konnten nicht zurückgesetzt werden. Prüfe, ob dies ein Git-Repository ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some files could not be reverted. Check that this is a git repository."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron revertir algunos archivos. Comprueba que este sea un repositorio git."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains fichiers n'ont pas pu être annulés. Vérifiez qu'il s'agit d'un dépôt git."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のファイルを取り消せませんでした。ここが git リポジトリか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 파일을 되돌릴 수 없습니다. 여기가 git 저장소인지 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns arquivos não puderam ser revertidos. Verifique se este é um repositório git."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось отменить некоторые файлы. Убедитесь, что это git-репозиторий."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分文件无法撤销。请检查这是否是一个 git 仓库。"
          }
        }
      }
    },
