          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントの変更を取り消しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트 변경 사항을 되돌리시겠습니까?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reverter as alterações do agente?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменить изменения агента?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销智能体的更改？"
          }
        }
      }
