    "agentHistory.undoUnavailableReason": {
      "comment": "Agent History: safety explanation for entries without a verified reversible change set (#1183).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Eintrag enthält keinen verifizierten umkehrbaren Änderungssatz; eine Rücknahme könnte daher fremde Änderungen verwerfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This entry has no verified reversible change set, so undo could discard unrelated changes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta entrada no contiene un conjunto de cambios reversible verificado; deshacer podría descartar cambios ajenos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette entrée ne contient aucun jeu de modifications réversible vérifié ; l'annulation pourrait supprimer des modifications sans rapport."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この項目には検証済みの可逆変更セットがないため、取り消すと無関係な変更が失われる可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목에는 검증된 되돌리기 변경 세트가 없으므로 실행 취소 시 관련 없는 변경이 손실될 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta entrada não contém um conjunto de alterações reversível verificado; desfazer poderia descartar alterações não relacionadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В записи нет проверенного обратимого набора изменений, поэтому отмена может удалить несвязанные правки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此条目没有经过验证的可逆更改集，因此撤销操作可能会丢弃无关更改。"
          }
        }
      }
    },
