    "%@ — line %lld": {
      "comment": "A secondary line of text that shows the kind of symbol and the line number in the file where the symbol is defined.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ — line %2$lld"
          }
        }
      }
    },
    "%@%@%@": {
      "comment": "A row of text with a highlighted substring.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@%2$@%3$@"
          }
        }
      }
    },
    "%lld": {
      "comment": "A badge that shows the number of search results for a given file group.",
      "isCommentAutoGenerated": true
    },
    "1–%lld": {
      "comment": "A label that shows the range of valid line numbers.",
      "isCommentAutoGenerated": true
    },
    "42 or 42:10": {
      "comment": "A placeholder for the line number in the Go to Line dialog.",
