    "settings.agentHandoff.readOnlyContext.help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gibt relative offene Pfade und die Cursorposition an neue Pine-Terminals weiter. Quelltext wird nicht geteilt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exposes open relative paths and the caret position to new Pine terminals. No source text is shared."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Expone las rutas relativas abiertas y la posición del cursor a los nuevos terminales de Pine. No se comparte código fuente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Expose les chemins relatifs ouverts et la position du curseur aux nouveaux terminaux Pine. Aucun code source n’est partagé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開いている相対パスとカーソル位置を新しいPineターミナルに公開します。ソースコードは共有されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열린 상대 경로와 커서 위치를 새 Pine 터미널에 제공합니다. 소스 텍스트는 공유하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Expõe caminhos relativos abertos e a posição do cursor a novos terminais do Pine. Nenhum código-fonte é compartilhado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Передаёт открытые относительные пути и позицию курсора новым терминалам Pine. Исходный текст не передаётся."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向新的 Pine 终端提供已打开的相对路径和光标位置，不共享源代码。"
          }
        }
      }
    },
