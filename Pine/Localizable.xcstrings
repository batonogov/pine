    "agentHistory.emptyMessage": {
      "comment": "Agent History: empty-state explanation (#1073).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abgeschlossene Agenten-Sitzungen und beobachtete Dateiaktivitäten erscheinen hier. Heuristische Einträge dienen nur zur Überprüfung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finished agent sessions and observed file activity will appear here. Heuristic entries are review-only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las sesiones de agente finalizadas y la actividad de archivos observada aparecerán aquí. Las entradas heurísticas son solo para revisión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sessions d'agent terminées et l'activité de fichiers observée apparaîtront ici. Les entrées heuristiques sont en lecture seule."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終了したエージェントセッションと観測されたファイル操作がここに表示されます。推定に基づく項目は確認専用です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완료된 에이전트 세션과 관찰된 파일 활동이 여기에 표시됩니다. 휴리스틱 항목은 검토 전용입니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessões de agente finalizadas e a atividade de arquivos observada aparecerão aqui. Entradas heurísticas servem apenas para revisão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершённые сессии агента и наблюдаемая файловая активность появятся здесь. Эвристические записи доступны только для просмотра."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已完成的智能体会话和观察到的文件活动将显示在此处。启发式条目仅供查看。"
          }
        }
      }
    },
