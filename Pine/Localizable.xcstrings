          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia servidores compatíveis sob demanda para arquivos abertos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускает поддерживаемые серверы по мере необходимости для открытых файлов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据打开文件的需要启动受支持的服务器。"
          }
        }
      }
    },
    "settings.lsp.error.absolutePath": {
