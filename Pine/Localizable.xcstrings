    "agentHistory.revertPartialFailure": {
      "comment": "Agent History: banner shown when some files failed to revert (#1073).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Dateien konnten nicht zurückgesetzt werden. Prüfe, ob dies ein Git-Repository ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some files could not be reverted. Check that this is a git repository."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron revertir algunos archivos. Comprueba que este sea un repositorio git."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains fichiers n'ont pas pu être annulés. Vérifiez qu'il s'agit d'un dépôt git."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のファイルを取り消せませんでした。ここが git リポジトリか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 파일을 되돌릴 수 없습니다. 여기가 git 저장소인지 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns arquivos não puderam ser revertidos. Verifique se este é um repositório git."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось отменить некоторые файлы. Убедитесь, что это git-репозиторий."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分文件无法撤销。请检查这是否是一个 git 仓库。"
          }
        }
      }
    },
    "agentHistory.checkedRevertConfirmMessage": {
      "comment": "Agent History: confirmation for a verified, checked undo that restores the recorded before-state (#1183).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird der genaue Zustand vor den Änderungen des Agenten wiederhergestellt. Danach bearbeitete Dateien bleiben unangetastet. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This restores the exact state recorded before the agent's changes. Files edited since the agent ran are left untouched. This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto restaura el estado exacto registrado antes de los cambios del agente. Los archivos editados desde la ejecución del agente no se modifican. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela restaure l'état exact enregistré avant les modifications de l'agent. Les fichiers modifiés depuis l'exécution de l'agent ne sont pas touchés. Action irréversible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントの変更前の正確な記録状態を復元します。エージェント実行後に編集されたファイルはそのまま残ります。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트 변경 전에 기록된 정확한 상태로 복원합니다. 에이전트 실행 이후에 편집된 파일은 그대로 유지됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso restaura o estado exato registrado antes das alterações do agente. Arquivos editados desde a execução do agente não são modificados. Isso não pode ser desfeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это восстанавливает точное состояние, записанное до изменений агента. Файлы, изменённые после запуска агента, остаются нетронутыми. Действие необратимо."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将恢复代理更改之前记录的确切状态。代理运行后编辑的文件保持不变。此操作无法撤销。"
          }
        }
      }
    },
