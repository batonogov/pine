        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz doble clic o pulsa Comando-Retorno para mantener este archivo abierto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-cliquez ou appuyez sur Commande-Retour pour garder ce fichier ouvert"
