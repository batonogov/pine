          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅提供有限元数据，不包含文件内容或所选文本。"
          }
        }
      }
    },
    "settings.agentHandoff.noMutation": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewährt keinen Schreib-, Befehls-, Navigations-, Wiederholungs- oder Rückgängigzugriff."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Does not grant write, command, navigation, replay, or undo access."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No concede acceso de escritura, comandos, navegación, repetición ni deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N’accorde aucun accès d’écriture, de commande, de navigation, de répétition ou d’annulation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き込み、コマンド、ナビゲーション、再実行、取り消しの権限は付与しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓰기, 명령, 탐색, 재실행 또는 실행 취소 권한을 부여하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não concede acesso de escrita, comando, navegação, repetição ou desfazer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не даёт доступа к записи, командам, навигации, повтору или отмене."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不授予写入、命令、导航、重放或撤销权限。"
          }
        }
      }
    },
    "settings.agentHandoff.newTerminals": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für neue Terminalprozesse; beim Deaktivieren wird der veröffentlichte Snapshot entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to new terminal processes; disabling removes the published snapshot."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica a nuevos procesos de terminal; al desactivarlo se elimina la instantánea publicada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique aux nouveaux processus de terminal ; la désactivation supprime l’instantané publié."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しいターミナルプロセスに適用され、無効にすると公開済みスナップショットが削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
