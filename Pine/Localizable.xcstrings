    "verifiedDiff.stalenessNotice": {
      "comment": "Safety notice explaining that a prepared preview can become stale.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit einem einzelnen Arbeitsbereich-Snapshot geprüft. Pine muss Autorität und aktuelle Dateien unmittelbar vor der Anwendung erneut prüfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checked against one workspace snapshot. Pine must revalidate authority and current files immediately before applying."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprobado con una instantánea del espacio de trabajo. Pine debe volver a validar la autorización y los archivos actuales justo antes de aplicar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifié sur un instantané de l’espace de travail. Pine doit revalider l’autorité et les fichiers actuels juste avant l’application."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 つのワークスペーススナップショットに対して確認済みです。適用直前に Pine が権限と現在のファイルを再検証する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하나의 작업 공간 스냅샷을 기준으로 확인되었습니다. 적용 직전에 Pine이 권한과 현재 파일을 다시 검증해야 합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificado em um snapshot do espaço de trabalho. O Pine deve revalidar a autoridade e os arquivos atuais imediatamente antes de aplicar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверено относительно одного снимка рабочей области. Непосредственно перед применением Pine должен заново проверить полномочия и текущие файлы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已根据一个工作区快照进行检查。应用前，Pine 必须立即重新验证权限和当前文件。"
          }
        }
      }
    },
