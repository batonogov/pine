    "settings.lsp.enabled.help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet unterstützte Server bei Bedarf für geöffnete Dateien."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts supported servers on demand for open files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia bajo demanda los servidores compatibles para los archivos abiertos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarre les serveurs pris en charge à la demande pour les fichiers ouverts."
          }
        },
