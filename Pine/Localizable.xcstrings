          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "制限されたメタデータのみ。ファイル内容や選択テキストは含みません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제한된 메타데이터만 제공하며 파일 내용이나 선택한 텍스트는 포함하지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
