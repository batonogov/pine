    "agentHistory.recoveryNoticeInstruction": {
      "comment": "Agent History recovery notice: explains that recovery discovery is read-only and requires manual review.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pine stellt diese Daten niemals automatisch wieder her. Prüfen Sie die aufgeführten privaten Sicherungen, bevor Sie sie entfernen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pine never restores this data automatically. Inspect the listed private backups before removing them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pine nunca restaura estos datos automáticamente. Revisa las copias privadas indicadas antes de eliminarlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pine ne restaure jamais ces données automatiquement. Vérifiez les sauvegardes privées indiquées avant de les supprimer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Pine がこのデータを自動的に復元することはありません。削除する前に、表示されたプライベートバックアップを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Pine은 이 데이터를 자동으로 복원하지 않습니다. 삭제하기 전에 표시된 비공개 백업을 검토하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Pine nunca restaura estes dados automaticamente. Inspecione os backups privados listados antes de removê-los."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Pine никогда не восстанавливает эти данные автоматически. Проверьте указанные приватные резервные копии перед удалением."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Pine 绝不会自动恢复这些数据。请在移除前检查列出的私有备份。"
          }
        }
      }
    },
