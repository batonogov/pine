    "settings.quickTerminal.enabled.help": {
      "comment": "Help text under the enable toggle.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Dropdown-Terminal über eine systemweite Tastenkombination von überall ein- und ausblenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Toggle the drop-down terminal from anywhere with a system-wide keyboard shortcut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra el terminal desplegable desde cualquier lugar con un atajo de teclado de sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichez le terminal déroulant depuis n'importe où avec un raccourci clavier système."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム全体のキーボードショートカットで、どこからでもドロップダウンターミナルを切り替えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 전체 키보드 단축키로 어디서든 드롭다운 터미널을 켜고 끕니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterne o terminal suspenso de qualquer lugar com um atalho de teclado do sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вызывайте выпадающий терминал из любого места системным сочетанием клавиш."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过系统级键盘快捷键，随时随地切换下拉终端。"
          }
        }
      }
    },
