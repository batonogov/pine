    "settings.terminal.appearance.help": {
      "comment": "Explains how the terminal appearance policy selects a light or dark theme variant.",
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Legt fest, ob das Terminal der Systemdarstellung folgt oder immer die helle bzw. dunkle Variante verwendet." } },
        "en": { "stringUnit": { "state": "translated", "value": "Choose whether the terminal follows the system appearance or always uses the light or dark variant." } },
        "es": { "stringUnit": { "state": "translated", "value": "Elige si el terminal sigue la apariencia del sistema o usa siempre la variante clara u oscura." } },
        "fr": { "stringUnit": { "state": "translated", "value": "Choisissez si le terminal suit l’apparence du système ou utilise toujours la variante claire ou sombre." } },
        "ja": { "stringUnit": { "state": "translated", "value": "ターミナルがシステムの外観に従うか、常にライトまたはダークを使うかを選びます。" } },
        "ko": { "stringUnit": { "state": "translated", "value": "터미널이 시스템 화면 모드를 따를지, 항상 라이트 또는 다크 변형을 사용할지 선택합니다." } },
        "pt-BR": { "stringUnit": { "state": "translated", "value": "Escolha se o terminal segue a aparência do sistema ou sempre usa a variante clara ou escura." } },
        "ru": { "stringUnit": { "state": "translated", "value": "Выберите, следует ли терминал системному оформлению или всегда использует светлый либо тёмный вариант." } },
        "zh-Hans": { "stringUnit": { "state": "translated", "value": "选择终端是跟随系统外观，还是始终使用浅色或深色版本。" } }
      }
