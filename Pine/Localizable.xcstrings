    "agentHistory.revertConfirmMessage": {
      "comment": "Agent History: revert confirmation alert message (#1073).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies führt „git checkout“ für die Dateien des Durchlaufs aus und verwirft die Änderungen des Agenten. Das kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This runs git checkout on the run's files, discarding the agent's changes. This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto ejecuta git checkout en los archivos de la ejecución, descartando los cambios del agente. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela exécute git checkout sur les fichiers de l'exécution, annulant les modifications de l'agent. Action irréversible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行のファイルに対して git checkout を実行し、エージェントの変更を破棄します。この操作は元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행의 파일에 대해 git checkout을 실행하여 에이전트의 변경 사항을 폐기합니다. 이 작업은 취소할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso executa git checkout nos arquivos da execução, descartando as alterações do agente. Não pode ser desfeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это выполнит git checkout для файлов запуска, отбросив изменения агента. Действие необратимо."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会对该运行的文件执行 git checkout，丢弃智能体的更改。此操作无法撤销。"
          }
        }
      }
    },
    "agentHistory.revertConfirmTitle": {
      "comment": "Agent History: revert confirmation alert title (#1073).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten-Änderungen zurücksetzen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Revert Agent Changes?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Revertir los cambios del agente?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuler les modifications de l'agent ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントの変更を取り消しますか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트 변경 사항을 되돌리시겠습니까?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reverter as alterações do agente?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменить изменения агента?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "撤销智能体的更改？"
          }
        }
      }
    },
    "agentHistory.revertPartialFailure": {
      "comment": "Agent History: banner shown when some files failed to revert (#1073).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Dateien konnten nicht zurückgesetzt werden. Prüfe, ob dies ein Git-Repository ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some files could not be reverted. Check that this is a git repository."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron revertir algunos archivos. Comprueba que este sea un repositorio git."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains fichiers n'ont pas pu être annulés. Vérifiez qu'il s'agit d'un dépôt git."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部のファイルを取り消せませんでした。ここが git リポジトリか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 파일을 되돌릴 수 없습니다. 여기가 git 저장소인지 확인하세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns arquivos não puderam ser revertidos. Verifique se este é um repositório git."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось отменить некоторые файлы. Убедитесь, что это git-репозиторий."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分文件无法撤销。请检查这是否是一个 git 仓库。"
          }
        }
      }
    },
    "agentHistory.checkedRevertConfirmMessage": {
      "comment": "Agent History: confirmation for a verified, checked undo that restores the recorded before-state (#1183).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird der genaue Zustand vor den Änderungen des Agenten wiederhergestellt. Danach bearbeitete Dateien bleiben unangetastet. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This restores the exact state recorded before the agent's changes. Files edited since the agent ran are left untouched. This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto restaura el estado exacto registrado antes de los cambios del agente. Los archivos editados desde la ejecución del agente no se modifican. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela restaure l'état exact enregistré avant les modifications de l'agent. Les fichiers modifiés depuis l'exécution de l'agent ne sont pas touchés. Action irréversible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントの変更前の正確な記録状態を復元します。エージェント実行後に編集されたファイルはそのまま残ります。この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "에이전트 변경 전에 기록된 정확한 상태로 복원합니다. 에이전트 실행 이후에 편집된 파일은 그대로 유지됩니다. 이 작업은 되돌릴 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso restaura o estado exato registrado antes das alterações do agente. Arquivos editados desde a execução do agente não são modificados. Isso não pode ser desfeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это восстанавливает точное состояние, записанное до изменений агента. Файлы, изменённые после запуска агента, остаются нетронутыми. Действие необратимо."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将恢复代理更改之前记录的确切状态。代理运行后编辑的文件保持不变。此操作无法撤销。"
          }
        }
      }
    },
    "agentHistory.checkedRevertSuccess": {
      "comment": "Agent History: banner shown after a successful checked undo (#1183).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
