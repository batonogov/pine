    "a11y.sidebar.file.open.hint": {
      "comment": "VoiceOver hint explaining how to permanently open a sidebar file.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Doppelklicken oder Befehl-Eingabe drücken, um diese Datei geöffnet zu lassen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Double-click or press Command-Return to keep this file open"
