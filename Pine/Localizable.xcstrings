    "agentHistory.revertConfirmMessage": {
      "comment": "Agent History: revert confirmation alert message (#1073).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies führt „git checkout“ für die Dateien des Durchlaufs aus und verwirft die Änderungen des Agenten. Das kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This runs git checkout on the run's files, discarding the agent's changes. This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto ejecuta git checkout en los archivos de la ejecución, descartando los cambios del agente. No se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela exécute git checkout sur les fichiers de l'exécution, annulant les modifications de l'agent. Action irréversible."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行のファイルに対して git checkout を実行し、エージェントの変更を破棄します。この操作は元に戻せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행의 파일에 대해 git checkout을 실행하여 에이전트의 변경 사항을 폐기합니다. 이 작업은 취소할 수 없습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso executa git checkout nos arquivos da execução, descartando as alterações do agente. Não pode ser desfeito."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это выполнит git checkout для файлов запуска, отбросив изменения агента. Действие необратимо."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会对该运行的文件执行 git checkout，丢弃智能体的更改。此操作无法撤销。"
          }
        }
      }
    },
    "agentHistory.revertConfirmTitle": {
      "comment": "Agent History: revert confirmation alert title (#1073).",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten-Änderungen zurücksetzen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
