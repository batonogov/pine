    "userTask.outputConflict.title": {
      "comment": "Title shown when task output cannot safely replace an edited buffer.",
      "extractionState": "manual",
      "localizations": {
        "de": { "stringUnit": { "state": "translated", "value": "Aufgabenausgabe nicht angewendet" } },
